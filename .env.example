# Copy to .env in this folder and fill in. .env is gitignored; never commit a real key.

# Portkey gateway key (all model calls go through Portkey).
PORTKEY_API_KEY=

# Optional. The only allowed value is gpt-6-luna; any other value stops the backend.
# OPENAI_MODEL=gpt-6-luna

# Optional. Defaults shown.
# PORTKEY_BASE_URL=https://api.portkey.ai/v1
# LLM_REASONING_EFFORT=none
